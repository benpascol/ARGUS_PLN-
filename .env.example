# ==============================================================================
# 🔑 ENVIRONMENT CONFIGURATION TEMPLATE — PROJECT ARGUS
# ==============================================================================
# Salin berkas ini menjadi .env dan masukkan API Key resmi Anda.
# Dilarang keras melakukan commit berkas .env asli yang berisi kunci rahasia!

# NVIDIA NIM / Vision-Language Model API Key
API=your_nvidia_nim_api_key_here

# Konfigurasi Threshold Laplacian (Deteksi Blur)
BLUR_THRESHOLD=30.0

# Batch Processing Concurrency
CONCURRENCY_LIMIT=5
